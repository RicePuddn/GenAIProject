ols&lt;/b&gt;&lt;br&gt;+ policy tool" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="220" height="60" as="geometry"/></mxCell><mxCell id="propose" value="&lt;b&gt;Propose&lt;/b&gt; (structured)&lt;br&gt;outcome, note, writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="check" value="&lt;b&gt;Rule check&lt;/b&gt; (write gate)&lt;br&gt;replay → rules → citations →&lt;br&gt;unseen returns → route" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="400" width="220" height="70" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;Review&lt;/b&gt; (approver LLM)&lt;br&gt;approver route only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="535" width="220" height="60" as="geometry"/></mxCell><mxCell id="write" value="&lt;b&gt;Write&lt;/b&gt; (executor)&lt;br&gt;backend_write" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1120" y="650" width="220" height="60" as="geometry"/></mxCell><mxCell id="outcome" value="&lt;b&gt;Outcome&lt;/b&gt; = the&lt;br&gt;proposal's outcome (code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="520" width="220" height="60" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;Reply writer&lt;/b&gt; (LLM)&lt;br&gt;+ wording checks (code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="220" height="60" as="geometry"/></mxCell><mxCell id