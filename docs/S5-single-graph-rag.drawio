"><mxGeometry x="380" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="work" value="&lt;b&gt;Agent&lt;/b&gt; (LLM)&lt;br&gt;sees: the brief, its own tool results,&lt;br&gt;the policy overview; proposes from its evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="380" height="80" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;Tool registry&lt;/b&gt;: reads + policy only&lt;br&gt;records every call as evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="600" height="50" as="geometry"/></mxCell><mxCell id="prop" value="&lt;b&gt;Propose&lt;/b&gt; (same LLM, structured)&lt;br&gt;outcome, note, writes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="310" width="320" height="50" as="geometry"/></mxCell><mxCell id="reads" value="&lt;b&gt;7 read tools&lt;/b&gt;&lt;br&gt;get_customer_orders, get_order, …&lt;br&gt;through the account-scoped reader" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="80" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;policy&lt;/b&gt; tool&lt;br&gt;search → hybrid retriever + rerank&lt;br&gt;check → rules engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="300" height="80" as="geometry"/></mxCell><mxCell id="wp" value="&lt;b&gt;Write path&lt;/b&gt; (backend_write)&lt;br&gt;rule check → review → executor&lt;br&gt;one proposed write at a time&lt;br&gt;(gate reads order facts, scoped)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="320" height="80" as="geometry"/></mxCell><mxCell id="pgr" value="&lt;b&gt;Postgres (read)&lt;/b&gt;&lt;br&gt;orders, order_items, products,&lt;br&gt;shipments, shipment_items,&lt;br&gt;shipment_events, payments,&lt;br&gt;returns, return_items, refunds" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="260" height="100" as="geometry"/></mxCell><mxCell id="corp" value="&lt;b&gt;Pinecone index&lt;/b&gt;&lt;br&gt;chunks of the 2&lt;br&gt;policy PDFs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;rules.json&lt;/b&gt;&lt;br&gt;hard limits&lt;br&gt;(one rules engine)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="pgw" value="&lt;b&gt;Postgres (write)&lt;/b&gt;&lt;br&gt;returns, return_items, refunds,&lt;br&gt;orders / items / shipments&lt;br&gt;(cancel), backend_writes" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="280" height="100" as="geometry"/></mxCell><mxCell id="appr" value="&lt;b&gt;Approver&lt;/b&gt; (LLM)&lt;br&gt;sees: the write, its evidence,&lt;br&gt;rule check, review_reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="430" width="240" height="80" as="geometry"/></mxCell><mxCell id="rw" value="&lt;b&gt;Reply writer&lt;/b&gt; (LLM)&lt;b