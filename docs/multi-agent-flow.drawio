ometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="275"/></Array></mxGeometry></mxCell><mxCell id="flowe36" value="wants human, duplicate, no specialist,&lt;br&gt;low confidence, triage failed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.136;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dTriage" target="handoff"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="500"/></Array></mxGeometry></mxCell><mxCell id="flowe37" value="guard / budget" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="handoff" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flowe38" value="other reasons" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="handoff" target="reply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flowe39" value="fails review twice&lt;br&gt;(+ handoff)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="reply" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flowe40" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reply" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flowe41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hold" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="1950"/></Array></mxGeometry></mxCell><mxCell id="legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="260" height="300" as="geometry"/></mxCell><mxCell id="lg0" value="LLM call" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1420" y="95" width="220" height="32" as="geometry"/></mxCell><mxCell id="lg1" value="Deterministic code" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1420" y="137" width="220" height="32" as="geometry"/></mxCell><mxCell id="lg2" value="Decision in code" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1420" y="179" width="220" height="32" as="geometry"/></mxCell><mxCell id="lg3" value="Human handoff path" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1420" y="221" width="220" height="32" as="geometry"/></mxCell><mxCell id="lg4" value="Waiting on the customer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1420" y="263" width="220" height="32" as="geometry"/></mxCell><mxCell id="lg5" value="Customer in / out" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1420" y="305" width="220" height="32" as="geometry"/></mxCell><mxCell id="principle" value="&lt;b&gt;LLMs propose, deterministic code disposes.&lt;/b&gt;&lt;br&gt;Every &lt;i&gt;next&lt;/i&gt; step is set by code in the node; LLMs only produce typed outputs (Triage, Proposal, verdicts, reply text) that the code reads. Thresholds come from policy/rules.json.&lt;br&gt;&lt;br&gt;&lt;b&gt;Two settings&lt;/b&gt;, each react | plan_and_execute:&lt;br&gt;• &lt;i&gt;orchestration&lt;/i&gt; (supervisor): plan = triage lists every part up front; react = the orchestrate step picks each part after seeing the last.&lt;br&gt;• &lt;i&gt;strategy&lt;/i&gt; (specialists): plan = list the tool calls, run them, propose; react = one tool call per turn.&lt;br&gt;&lt;br&gt;Each part runs specialist → decide → execute with its own gates. The strictest part decides the ticket: human, then customer, then resolved.&lt;br&gt;&lt;br&gt;A budget hit in any node hands the whole ticket off with the fixed hold reply." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1400" y="380" width="260" height="380" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="comp" name="Components"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="S3 multi-agent with RAG policy: components" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="40" as="geometry"/></mxCell><mxCell id="customer" value="Customer" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="140" height="60" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Streamlit page&lt;/b&gt;&lt;br&gt;scripts/demo_multi_agent.py&lt;br&gt;live timeline" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="260" y="65" width="240" height="70" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;FastAPI&lt;/b&gt; api_multi.py (:8001)&lt;br&gt;/chat, /chat/stream (SSE)&lt;br&gt;4 workers, cancel on disconnect, stateless" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="60" width="320" height="80" as="geometry"/></mxCell><mxCell id="compe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="customer" target="ui"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="compe2" value="POST + history" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="wf" value="MultiAgentWorkflow (LangGraph StateGraph) · systems/multi_agent.py" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1180" height="560" as="geometry"/></mxCell><mxCell id="gAgents" value="Agents (LLM)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;dashed=1;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="470" height="490" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Guard&lt;/b&gt;&lt;br&gt;agents/guard.py&lt;br&gt;Prompt Guard 2, every turn" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="90" y="270" width="200" height="70" as="geometry"/></mxCell><mxCell id="sup" value="&lt;b&gt;Supervisor&lt;/b&gt;&lt;br&gt;supervisor/supervisor.py&lt;br&gt;triage · orch