<mxfile host="app.diagrams.net" type="device"><diagram id="flow" name="Ticket flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="S3 multi-agent with RAG policy: ticket flow" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="600" height="40" as="geometry"/></mxCell><mxCell id="start" value="Customer message&lt;br&gt;+ history (from the client)" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="340" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Guard&lt;/b&gt; (Prompt Guard 2)&lt;br&gt;screens every turn in 1,000-char chunks" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="260" height="60" as="geometry"/></mxCell><mxCell id="dGuard" value="benign?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="390" y="240" width="100" height="70" as="geometry"/></mxCell><mxCell id="triage" value="&lt;b&gt;Supervisor: triage&lt;/b&gt; (LLM)&lt;br&gt;plan: tasks, one per specialist, each with its part&lt;br&gt;wants_human, duplicate_of, off_topic, confidence" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="340" width="300" height="80" as="geometry"/></mxCell><mxCell id="orch" value="&lt;b&gt;Supervisor: orchestrate&lt;/b&gt; (LLM)&lt;br&gt;&lt;i&gt;react only&lt;/i&gt;: sees parts_done,&lt;br&gt;delegates the next part or finishes" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="455" width="230" height="100" as="geometry"/></mxCell><mxCell id="dTriage" value="triage_escalation&lt;br&gt;(code)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="450" width="140" height="100" as="geometry"/></mxCell><mxCell id="spec" value="&lt;b&gt;Specialist for the next task&lt;/b&gt; (LLM)&lt;br&gt;orders_shipping | returns_refunds&lt;br&gt;react | plan_and_execute&lt;br&gt;brief.your_task = its part" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="300" y="600" width="280" height="90" as="geometry"/></mxCell><mxCell id="routeTool" value="&lt;b&gt;route tool&lt;/b&gt; (code)&lt;br&gt;facts from Postgres → min_route (rules.json)&lt;br&gt;rejects looser routes, out-of-domain actions,&lt;br&gt;over-paid refunds; bounces unseen returns" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="650" y="600" width="290" height="90" as="geometry"/></mxCell><mxCell id="dSpec" value="specialist&lt;br&gt;outcome&lt;br&gt;(code)" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="730" width="140" height="100" as="geometry"/></mxCell><mxCell id="dMissing" value="record not found:&lt;br&gt;same ID repeated&lt;br&gt;in this message?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="725" width="170" height="110" as="geometry"/></mxCell><mxCell id="wait" value="Ticket → &lt;b&gt;awaiting_customer&lt;/b&gt;&lt;br&gt;(question or redirect)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="990" y="740" width="200" height="60" as="geometry"/></mxCell><mxCell id="dRoute" value="route" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="390" y="880" width="100" height="80" as="geometry"/></mxCell><mxCell id="approver" value="&lt;b&gt;Approver&lt;/b&gt; (LLM)&lt;br&gt;pre-execution proposal check" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="650" y="890" width="220" height="60" as="geometry"/></mxCell><mxCell id="dAppr" value="verdict" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="710" y="1000" width="100" height="80" as="geometry"/></mxCell><mxCell id="gateway" value="&lt;b&gt;Gateway&lt;/b&gt;: TicketFlow.approve (code)&lt;br&gt;re-checks min route, issues token&lt;br&gt;bound to ticket, operation, order, amount" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="1130" width="280" height="70" as="geometry"/></mxCell><mxCell id="dToken" value="write&lt;br&gt;needed?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="390" y="1240" width="100" height="80" as="geometry"/></mxCell><mxCell id="execute" value="&lt;b&gt;Mock write&lt;/b&gt; (code)&lt;br&gt;token + idempotency check, audited" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="1370" width="260" height="60" as="geometry"/></mxCell><mxCell id="dPart" value="part done:&lt;br&gt;what next?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="1480" width="120" height="90" as="geometry"/></mxCell><mxCell id="settle" value="settle:&lt;br&gt;strictest part" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="380" y="1600" width="120" height="90" as="geometry"/></mxCell><mxCell id="handoff" value="&lt;b&gt;Handoff&lt;/b&gt; (code)&lt;br&gt;packet (lists every part)&lt;br&gt;ticket → awaiting_human" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="1760" width="220" height="80" as="geometry"/></mxCell><mxCell id="hold" value="Fixed hold reply&lt;br&gt;(no LLM call)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="1900" width="220" height="60" as="geometry"/></mxCell><mxCell id="reply" value="&lt;b&gt;Reply&lt;/b&gt;: customer_outcome per part (code)&lt;br&gt;→ supervisor drafts (LLM)&lt;br&gt;→ approver reply check (LLM), max 2 drafts" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="290" y="1770" width="300" height="90" as="geometry"/></mxCell><mxCell id="end" value="Reply sent&lt;br&gt;resolved | awaiting_customer | awaiting_human" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="1920" width="240" height="60" as="geometry"/></mxCell><mxCell id="flowe1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="guard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flowe2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="guard" target="dGuard"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id=