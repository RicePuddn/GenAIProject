<mxfile host="app.diagrams.net"><diagram name="S1-S2-single-agentic" id="S1-S2-single-agentic"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;S1 (RAG) / S2 (skills): single agent, agentic&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="-40" width="700" height="30" as="geometry"/></mxCell><mxCell id="msg" value="Customer message&lt;br&gt;+ history" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="220" height="70" as="geometry"/></mxCell><mxCell id="guard" value="Guard&lt;br&gt;(Prompt Guard)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="220" height="70" as="geometry"/></mxCell><mxCell id="agent" value="&lt;b&gt;Agent&lt;/b&gt;&lt;br&gt;react | plan_execute&lt;br&gt;reads, policy, backend_write,&lt;br&gt;request_review, finish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="220" height="80" as="geometry"/></mxCell><mxCell id="gate" value="&lt;b&gt;Write gate&lt;/b&gt;&lt;br&gt;rules → citations →&lt;br&gt;unseen returns/refunds →&lt;br&gt;stricter route" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="250" width="220" height="80" as="geometry"/></mxCell><mxCell id="review" value="Independent review&lt;br&gt;(approver), asked for&lt;br&gt;with request_review" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="220" height="80" as="geometry"/></mxCell><mxCell id="exec" value="Write executor&lt;br&gt;(once per key)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="390" width="220" height="70" as="geometry"/></mxCell><mxCell id="reply" value="Reply writer&lt;br&gt;+ wording checks (code)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="220" height="70" as="geometry"/></mxCell><mxCell id="check" value="Reply check&lt;br&gt;(approver)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="220" height="70" as="geometry"/></mxCell><mxCell id="save" value="Ticket save (code)&lt;br&gt;support_tickets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="220" height="70" as="geometry"/></mxCell><mxCell id="hold" value="Hold reply&lt;br&gt;+ handoff packet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="340" y="650" width="220" height="70" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="msg" target="guard"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="benign" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="guard" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="flagged" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="guard" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="backend_write /&lt;br&gt;request_review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="agent" target="gate"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="approver route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gate" target="review"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="approved / rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="review" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gate" target="exec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="exec" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="finish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="agent" target="reply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="handoff: turn ends" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="gate" target="reply"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="budget" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="agent" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="reply" target="check"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="check" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="no draft passes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="check" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="hold" target="save"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="Green: an agent (its strategy decides its steps). Blue: shared gates, the same code in every setup. Yellow: a stage the graph runs. Red: the fixed hold reply. Every turn ends in the same reply, reply check and ticket save." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="760" width="560" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
