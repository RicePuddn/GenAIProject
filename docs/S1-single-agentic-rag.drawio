 tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="780" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="S1: who sees what, and which data each layer touches (Data flow &amp; access)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="-40" width="1100" height="26" as="geometry"/></mxCell><mxCell id="brief" value="&lt;b&gt;Customer brief&lt;/b&gt;&lt;br&gt;message, history (untrusted),&lt;br&gt;signed_in_account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b&gt;Guard&lt;/b&gt; (LLM)&lt;br&gt;sees only the new message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="40" width="260" height="70" as="geometry"/></mxCell><mxCell id="work" value="&lt;b&gt;Agent&lt;/b&gt; (LLM)&lt;br&gt;sees: the brief, its own tool results,&lt;br&gt;the policy overview" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="170" width="380" height="80" as="geometry"/></mxCell><mxCell id="reg" value="&lt;b&gt;Tool registry&lt;/b&gt; (one per ticket): validates arguments and results, records every call and result as turn evidence" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="960" height="50" as="geometry"/></mxCell><mxCell id="reads" value="&lt;b&gt;7 read tools&lt;/b&gt;&lt;br&gt;get_customer_orders, get_order, …&lt;br&gt;through the account-scoped reader" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="260" height="80" as="geometry"/></mxCell><mxCell id="pol" value="&lt;b&gt;policy&lt;/b&gt; tool&lt;br&gt;search → hybrid retriever + rerank&lt;br&gt;check → rules engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="430" width="300" height="80" as="geometry"/></mxCell><mxCell id="wp" value="&lt;b&gt;Write path&lt;/b&gt;&lt;br&gt;named write / request_review&lt;br&gt;→ write gate → executor&lt;br&gt;(gate reads order facts, scoped)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="320" height="80" as="geometry"/></mxCell><mxCell id="pgr" value="&lt;b&gt;Postgres (read)&lt;/b&gt;&lt;br&gt;orders, order_items, products,&lt;br&gt;shipments, shipment_items,&lt;br&gt;shipment_events, payments,&lt;br&gt;returns, return_items, refunds" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="260" height="100" as="geometry"/></mxCell><mxCell id="corp" value="&lt;b&gt;Pinecone index&lt;/b&gt;&lt;br&gt;chunks of the 2&lt;br&gt;policy PDFs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b&gt;rules.json&lt;/b&gt;&lt;br&gt;hard limits&lt;br&gt;(one rules engine)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="580" y="560" width="200" height="80" as="geometry"/></mxCell><mxCell id="pgw" value="&lt;b&gt;Postgres (write)&lt;/b&gt;&lt;br&gt;returns, return_items, refunds,&lt;br&gt;orders / items / shipments&lt;br&gt;(cancel), backend_writes" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="560" width="280" height="100" as="geometry"/></mxCell><mxCell id="appr" value="&lt;b&gt;Approver&lt;/b&gt; (LLM)&lt;br&gt;sees: the write, its evidence,&lt;br&gt;rule check, review_reason" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="430" width="240" height="80" as="geometry"/></mxCell><mxCell id="rw" value="&lt;b&gt;Reply writer&lt;/b&gt; (LLM)&lt;br&gt;sees: outcome, note, evidence,&lt;br&gt;problems code found" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="300" width="260" height="80" as="geometry"/></mxCell><mxCell id="tk" value="&lt;b&gt;Ticket save&lt;/b&gt; (code)&lt;br&gt;status, reply, handoff packet&lt;br&gt;→ support_tickets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1440" y="560" width="260" height="80" as="geometry"/></mxCell><mxCell id="legend" value="Green: an LLM agent (its strategy decides its steps). Orange: tools. Blue: shared gates and LLM checks (the same code in every system). Yellow: a stage code runs. Purple: a data store. Grey: input and output." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="700" height="50" as="geometry"/></mxCell><mxCell id="d_bg" value="message" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="brief" target="guard"><mxGeometry x=