# Copy to .env and fill in. Never commit .env.
# Ollama is the default LLM provider. For Azure OpenAI, set
# SUPPORT_OPS_CONFIG=configs/azure_openai.yaml and fill in the Azure variables below.
# Model deployments are selected by the aliases configured in configs/azure_openai.yaml.
# SUPPORT_OPS_CONFIG=configs/ollama.yaml
# AZURE_OPENAI_APIM_API_KEY=
# AZURE_OPENAI_APIM_ENDPOINT=
# AZURE_OPENAI_CHAT_API_VERSION=
# GPT52_DEPLOYMENT_NAME=
# GPT5_DEPLOYMENT_NAME=
# GPT5_MINI_DEPLOYMENT_NAME=
# Copy required values from your approved Azure configuration; never commit .env.
# Local PostgreSQL: keep this URL in sync with the password and host port below.
POSTGRES_PASSWORD=support_ops_local
POSTGRES_PORT=5432
SUPPORT_OPS_DATABASE_URL=postgresql://support_ops:support_ops_local@127.0.0.1:5432/support_ops
# Optional: a separate login for the multi-agent writes. Unset, writes use SUPPORT_OPS_DATABASE_URL.
# SUPPORT_OPS_WRITE_DATABASE_URL=

# Pinecone DB API key
PINECONE_API_KEY =
