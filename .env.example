# Copy to .env and fill in. Never commit .env.
# Local Ollama is the only supported LLM provider.
# Start Ollama and pull the configured model before starting the API.
# Local PostgreSQL: keep this URL in sync with the password and host port below.
POSTGRES_PASSWORD=support_ops_local
POSTGRES_PORT=5432
SUPPORT_OPS_DATABASE_URL=postgresql://support_ops:support_ops_local@127.0.0.1:5432/support_ops
# Optional: a separate login for the multi-agent writes. Unset, writes use SUPPORT_OPS_DATABASE_URL.
# SUPPORT_OPS_WRITE_DATABASE_URL=

# Pinecone DB API key
PINECONE_API_KEY =
